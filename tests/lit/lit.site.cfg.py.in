"""Lit site configuration for KernelSmith tests."""

import os
import lit.llvm

# Configuration
config.llvm_tools_dir = "@LLVM_TOOLS_BINARY_DIR@"
config.ks_tools_dir = "@LLVM_RUNTIME_OUTPUT_INTDIR@"
config.ks_src_dir = "@CMAKE_CURRENT_SOURCE_DIR@"
config.ks_build_dir = "@CMAKE_CURRENT_BINARY_DIR@"

# Let the main config do the work
lit.llvm.initialize(lit_config, config)

config_path = os.path.join(config.ks_src_dir, "lit", "lit.cfg.py")
lit_config.load_config(config, config_path)
